# Example environment file for systemd unit `evb-tmux.service`.
# Copy this to /etc/default/volleyball_site.env and adjust values for your system.

# Absolute path to the project root (where manage.py lives)
APP_ROOT=/home/volleyball/eastside_vb_website

# Virtualenv path (relative to APP_ROOT or absolute). Defaults to $APP_ROOT/.venv
VENV_PATH=$APP_ROOT/.venv

# tmux session name
TMUX_SESSION=evb

# Optional: user to run services as (the unit runs commands directly; consider running
# the unit as the desired user with `User=` in a copy of the unit file).
#RUN_AS_USER=volleyball
## Example environment file for systemd services
# Copy to /etc/default/volleyball_site.env and edit values for your deployment

# Django
DJANGO_SECRET_KEY=please_change_me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,localhost,127.0.0.1

# Email
DEFAULT_FROM_EMAIL=noreply@example.com
DEFAULT_FROM_NAME=Eastside VB
DEFAULT_REPLY_TO=support@example.com

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here

# GPT Model Selection
# Choose which GPT model to use for AI summaries
# Options: gpt-3.5-turbo, gpt-4, gpt-4-turbo, gpt-5.1-codex-max
OPENAI_GPT_MODEL=gpt-3.5-turbo

# GPT-5.1-Codex-Max Feature
# Set to 'True' to enable GPT-5.1-Codex-Max for all clients
ENABLE_GPT_5_1_CODEX_MAX=False