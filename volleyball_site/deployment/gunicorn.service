[Unit]
Description=gunicorn daemon for volleyball_site
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/path/to/your/project/volleyball_site
# Update the ExecStart path to your virtualenv's gunicorn binary
ExecStart=/path/to/your/project/.venv/bin/gunicorn \
    --access-logfile - \
    --workers 3 \
    --bind unix:/run/gunicorn.sock \
    volleyball_site.wsgi:application

[Install]
WantedBy=multi-user.target
