{% extends "base.html" %}

{% block title %}Coach Dashboard - Eastside Volleyball{% endblock %}

{% block content %}
<div class="container mt-4">
    <!-- Header with Admin Panel Button -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h1 class="display-5">🏐 Coach Dashboard</h1>
            <p class="text-muted">Manage your team, players, videos, and more</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="/admin/" class="btn btn-danger btn-lg shadow-sm" style="min-width: 200px;">
                <i class="bi bi-shield-lock-fill"></i> Admin Panel
            </a>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Players</h5>
                    <h2 class="mb-0">{{ total_players }}</h2>
                    <small>Team Members</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Videos</h5>
                    <h2 class="mb-0">{{ total_videos }}</h2>
                    <small>Game Videos</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info mb-3">
                <div class="card-body">
                    <h5 class="card-title">Profiles</h5>
                    <h2 class="mb-0">{{ total_profiles }}</h2>
                    <small>Player Profiles</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Users</h5>
                    <h2 class="mb-0">{{ total_users }}</h2>
                    <small>Total Accounts</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Management Sections -->
    <div class="row">
        <!-- Team Management -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-people"></i> Team Management</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a href="{% url 'team:player-list' %}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-person-badge"></i> Players</span>
                        <span class="badge bg-primary rounded-pill">{{ total_players }}</span>
                    </a>
                    <a href="/admin/team/player/add/" class="list-group-item list-group-item-action">
                        <i class="bi bi-plus-circle"></i> Add New Player
                    </a>
                    <a href="/admin/team/playerprofile/" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-card-list"></i> Player Profiles</span>
                        <span class="badge bg-info rounded-pill">{{ total_profiles }}</span>
                    </a>
                    <a href="/admin/team/playerstats/" class="list-group-item list-group-item-action">
                        <i class="bi bi-bar-chart"></i> Player Statistics
                    </a>
                </div>
            </div>
        </div>

        <!-- Video Management -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-camera-video"></i> Video Management</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a href="{% url 'team:video_list' %}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-collection-play"></i> All Videos</span>
                        <span class="badge bg-success rounded-pill">{{ total_videos }}</span>
                    </a>
                    <a href="{% url 'team:video_upload' %}" class="list-group-item list-group-item-action">
                        <i class="bi bi-upload"></i> Upload New Video
                    </a>
                    <a href="/admin/team/gamevideo/" class="list-group-item list-group-item-action">
                        <i class="bi bi-gear"></i> Manage Videos (Admin)
                    </a>
                    <a href="/admin/team/aisummary/" class="list-group-item list-group-item-action">
                        <i class="bi bi-robot"></i> AI Summaries
                    </a>
                </div>
            </div>
        </div>

        <!-- Access & Security -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-shield-lock"></i> Access & Security</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a href="{% url 'team:coach_codes' %}" class="list-group-item list-group-item-action">
                        <i class="bi bi-key"></i> Access Codes
                    </a>
                    <a href="/admin/auth/user/" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-person-circle"></i> User Accounts</span>
                        <span class="badge bg-warning rounded-pill">{{ total_users }}</span>
                    </a>
                    <a href="/admin/auth/group/" class="list-group-item list-group-item-action">
                        <i class="bi bi-people-fill"></i> User Groups
                    </a>
                </div>
            </div>
        </div>

        <!-- Communication -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-megaphone"></i> Communication</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a href="{% url 'team:announcement_list' %}" class="list-group-item list-group-item-action">
                        <i class="bi bi-chat-square-text"></i> Announcements
                    </a>
                    <a href="{% url 'team:announcement_create' %}" class="list-group-item list-group-item-action">
                        <i class="bi bi-plus-circle"></i> Create Announcement
                    </a>
                    <a href="/admin/team/announcement/" class="list-group-item list-group-item-action">
                        <i class="bi bi-gear"></i> Manage Announcements
                    </a>
                </div>
            </div>
        </div>

        <!-- Advanced Settings -->
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="bi bi-gear-fill"></i> Advanced Settings</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a href="/admin/" class="list-group-item list-group-item-action">
                        <i class="bi bi-shield-check"></i> Full Django Admin Panel
                    </a>
                    <a href="/admin/django_celery_beat/periodictask/" class="list-group-item list-group-item-action">
                        <i class="bi bi-clock"></i> Scheduled Tasks
                    </a>
                    <a href="/admin/team/videoanalysis/" class="list-group-item list-group-item-action">
                        <i class="bi bi-film"></i> Video Analysis Records
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Recent Videos</h5>
                </div>
                <div class="list-group list-group-flush">
                    {% for video in recent_videos %}
                        <a href="{% url 'team:video_detail' video.pk %}" class="list-group-item list-group-item-action">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">{{ video.title }}</h6>
                                <small>{{ video.uploaded_at|date:"M d" }}</small>
                            </div>
                            <small class="text-muted">{{ video.game_type }} {% if video.opponent %}vs {{ video.opponent }}{% endif %}</small>
                        </a>
                    {% empty %}
                        <div class="list-group-item text-muted">No videos yet</div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Recent Announcements</h5>
                </div>
                <div class="list-group list-group-flush">
                    {% for announcement in announcements %}
                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">
                                    {% if announcement.is_urgent %}<span class="badge bg-danger">Urgent</span>{% endif %}
                                    {{ announcement.title }}
                                </h6>
                                <small>{{ announcement.created_at|date:"M d" }}</small>
                            </div>
                            <p class="mb-1 small">{{ announcement.message|truncatewords:15 }}</p>
                        </div>
                    {% empty %}
                        <div class="list-group-item text-muted">No announcements yet</div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">Quick Actions</h5>
                    <div class="btn-group" role="group">
                        <a href="{% url 'team:video_upload' %}" class="btn btn-primary">
                            <i class="bi bi-upload"></i> Upload Video
                        </a>
                        <a href="{% url 'team:announcement_create' %}" class="btn btn-info">
                            <i class="bi bi-megaphone"></i> New Announcement
                        </a>
                        <a href="/admin/team/player/add/" class="btn btn-success">
                            <i class="bi bi-person-plus"></i> Add Player
                        </a>
                        <a href="{% url 'team:coach_codes' %}" class="btn btn-warning">
                            <i class="bi bi-key"></i> Generate Access Code
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
